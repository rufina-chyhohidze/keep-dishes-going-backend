###
//http://localhost:8180/realms/keepdishesgoing/protocol/openid-connect/auth?client_id=backend-client&response_type=code&scope=openid&redirect_uri=http://localhost:3333/callback

POST http://localhost:8180/realms/keepdishesgoing/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

client_id=backend-client
    &client_secret=C1Ur8iF2SPSu3CtTx0tKsidAvmhRTiba
    &grant_type=authorization_code
    &scope=openid
    &redirect_uri=http://localhost:3333/callback
    &code=3e49132e-9ccf-4f62-a76b-e567f1fab4e9.ce23e1fc-9b3e-40c0-952e-358722461973.c3c0fda5-d051-439c-916b-f8ff9c2fb328
> {%
    client.global.set("access_token", response.body.access_token);
%}

### accept an order
POST http://localhost:8080/api/orders/e8f78fc8-5ed3-41f4-9c9a-3600757a8062/accept
Authorization: Bearer {{access_token}}
Content-Type: application/json

### reject with reason
POST http://localhost:8080/api/orders/378c1ab1-116c-4334-8fa1-f73c173cc196/reject
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "reason": "Restaurant is closed"
}
### mark as ready for pick up( only for accepted orders)
POST http://localhost:8080/api/orders/e8f78fc8-5ed3-41f4-9c9a-3600757a8062/ready
Authorization: Bearer {{access_token}}
Content-Type: application/json

